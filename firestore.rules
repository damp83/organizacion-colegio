rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true);
    }

    function isOwner(resourceData) {
      return isAuthenticated() && resourceData.createdBy == request.auth.uid;
    }

    function isAllowedUser() {
      return isAuthenticated() && (isAdmin() || request.auth.token.allowed == true || isAllowlistedEmail());
    }

    // Allowlist basada en emails exactos (ya que son cuentas del centro). No requerimos email_verified
    function isAllowlistedEmail() {
      return request.auth.token.email in [
          "alejandra.fernandez@murciaeduca.es",
          "anaadela.cordoba@murciaeduca.es",
          "anabelen.cano@murciaeduca.es",
          "anama.villacieros@murciaeduca.es",
          "andres.alcaraz@murciaeduca.es",
          "begona.tornel@murciaeduca.es",
          "belen.martinez2@murciaeduca.es",
          "carmenmarta.perez@murciaeduca.es",
          "catalina.alcazar@murciaeduca.es",
          "catalina.mendez2@murciaeduca.es",
          "celiam.requena@murciaeduca.es",
          "cristina.martinez25@murciaeduca.es",
          "cristina.vivo@murciaeduca.es",
          "estela.garcia@murciaeduca.es",
          "fulgencio.osete2@murciaeduca.es",
          "josefa.soto@murciaeduca.es",
          "josefrancisco.nicolas@murciaeduca.es",
          "josejuan.martinez@murciaeduca.es",
          "juanjose.almagro@murciaeduca.es",
          "laura.garcia6@murciaeduca.es",
          "luis.rodriguez5@murciaeduca.es",
          "luisfelipe.murcia@murciaeduca.es",
          "mariaangeles.noguera@murciaeduca.es",
          "mariaaraceli.cases@murciaeduca.es",
          "mariaester.carrillo@murciaeduca.es",
          "mariafrancisc.franco@murciaeduca.es",
          "mariajosefa.caballero@murciaeduca.es",
          "mariateresa.martinez4@murciaeduca.es",
          "marta.martinez3@murciaeduca.es",
          "nuria.alvarez@murciaeduca.es",
          "paloma.crespo@murciaeduca.es",
          "pedro.martinez39@murciaeduca.es",
          "rita.bohajar@murciaeduca.es",
          "sonia.escamez@murciaeduca.es",
          "teresa.fernandez2@murciaeduca.es",
          "diegoalberto.moya@murciaeduca.es"
        ];
    }

    // Base fields validator (usado en varias colecciones y encuestas)
    function hasValidBaseFields(newData) {
      return newData.timestamp is int && newData.createdBy == request.auth.uid;
    }

    // Validadores comunes
    function isIsoDate(s) {
      // YYYY-MM-DD simple check
      return s is string && s.size() == 10 && s.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isShortString(s, max) {
      return s is string && s.size() <= max;
    }

    function isHourString(s) {
      // Formato HH:MM 24h
      return s is string && s.size() == 5 && s.matches('^([0-1][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isHourRange(s) {
      // Formato HH:MM-HH:MM 24h
      return s is string && s.size() == 11 && s.matches('^([0-1][0-9]|2[0-3]):[0-5][0-9]-([0-1][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // Validación de tareas (personales o compartidas)
    function validTarea(d) {
      return isShortString(d.titulo, 300) &&
             (d.descripcion == null || isShortString(d.descripcion, 4000)) &&
             (d.tipo in ['Personal','Compartida']) &&
             (d.completada is bool) &&
             (d.fechaFin == null || d.fechaFin is int) &&
             (d.fechaLimite == null || d.fechaLimite is int) &&
             (d.estado == null || d.estado in ['Pendiente','En proceso','Enviada','Completada']);
    }

    // ENCUESTAS (match específico primero para que tenga precedencia sobre el genérico)
    match /artifacts/{appId}/public/data/encuestas/{docId} {
      allow read: if true;
      allow create: if isAllowedUser() && hasValidBaseFields(request.resource.data) && validEncuestasCreate(request.resource.data);
      // Update puede ser: a) edición por creador/admin, b) voto (incrementos)
      // Sólo usuarios registrados permitidos (no anónimos) para votar ahora.
      allow update: if (
          isAllowedUser() && (isAdmin() || isOwner(resource.data)) && validEncuestasEdit(resource.data, request.resource.data)
        ) || (
          isAllowedUser() && validEncuestasVote(resource.data, request.resource.data)
        );
      allow delete: if isAllowedUser() && (isAdmin() || isOwner(resource.data));

      function validEncuestasCreate(d) {
  return isShortString(d.pregunta, 300) && d.opciones is list && d.opciones.size() >= 2 && d.opciones.size() <= 30 &&
         (d.multiple == null || d.multiple is bool);
      }
      function validEncuestasVote(oldData, newData) {
        return newData.pregunta == oldData.pregunta &&
               newData.createdBy == oldData.createdBy &&
               newData.opciones is list && oldData.opciones is list &&
         newData.opciones.size() == oldData.opciones.size() &&
         (newData.multiple == oldData.multiple || (oldData.multiple == null && newData.multiple == null));
      }
      function validEncuestasEdit(oldData, newData) {
        return newData.createdBy == oldData.createdBy &&
               newData.timestamp is int &&
               isShortString(newData.pregunta, 300) &&
               newData.opciones is list && newData.opciones.size() >= 2 && newData.opciones.size() <= 30 &&
               (newData.multiple == null || newData.multiple is bool);
      }
    }

    // Rutas públicas genéricas (resto de colecciones)
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      allow read: if true; // público de solo lectura

  // Escrituras: solo usuarios permitidos (allowed) o admin; updates/deletes además exigen propiedad o admin
  allow create: if (
        (collection == 'tareas_compartidas' && isAuthenticated() && isValidCreate(collection, request.resource.data)) ||
        (collection != 'tareas_compartidas' && isAllowedUser() && isValidCreate(collection, request.resource.data))
      );
  allow update: if (
        (collection == 'encuestas' && isAuthenticated() && isValidUpdate(collection, resource.data, request.resource.data)) ||
        (collection == 'tareas_compartidas' && isAuthenticated() && (isAdmin() || isOwner(resource.data)) && isValidUpdate(collection, resource.data, request.resource.data)) ||
        (collection != 'encuestas' && collection != 'tareas_compartidas' && isAllowedUser() && (isAdmin() || isOwner(resource.data)) && isValidUpdate(collection, resource.data, request.resource.data))
      );
  allow delete: if (
        (collection == 'tareas_compartidas' && isAuthenticated() && (isAdmin() || isOwner(resource.data))) ||
        (collection != 'tareas_compartidas' && isAllowedUser() && (isAdmin() || isOwner(resource.data)))
      );


      function isValidCreate(col, newData) {
        return hasValidBaseFields(newData) && (
          (col == 'documentos' && validDocumentos(newData)) ||
          (col == 'anuncios' && validAnuncios(newData)) ||
          (col == 'actividades' && validActividades(newData)) ||
          (col == 'agenda' && validAgenda(newData)) ||
          (col == 'sustituciones' && validSustituciones(newData)) ||
          (col == 'tareas_compartidas' && validTarea(newData)) ||
          (col == 'notificaciones' && validNotificacion(newData))
        );
      }

      function isValidUpdate(col, oldData, newData) {
        return newData.createdBy == oldData.createdBy &&
               newData.timestamp is int && (
                 (col == 'documentos' && validDocumentos(newData)) ||
                 (col == 'anuncios' && validAnuncios(newData)) ||
                 (col == 'actividades' && validActividades(newData)) ||
                 (col == 'agenda' && validAgenda(newData)) ||
                 (col == 'sustituciones' && validSustituciones(newData)) ||
                 (col == 'tareas_compartidas' && validTarea(newData)) ||
                 (col == 'notificaciones' && validNotificacion(newData))
               );
      }

      function validDocumentos(d) {
        return isShortString(d.nombre, 200) &&
               isShortString(d.archivo, 400) &&
               isShortString(d.fecha, 20);
      }

      function validAnuncios(d) {
        return isShortString(d.texto, 1000);
      }

      function validActividades(d) {
  return isShortString(d.title, 200) &&
         isIsoDate(d.date) &&
         (d.time == null || isHourString(d.time)) &&
         // tipo sólo dos valores permitidos
         (d.tipo in ['dentro','salida']) &&
         // duración opcional 0..1440
         (d.duration == null || (d.duration is int && d.duration >= 0 && d.duration <= 1440)) &&
         // curso: lista obligatoria (al menos 1) tamaño razonable <= 30
         (d.curso is list && d.curso.size() >= 1 && d.curso.size() <= 30) &&
         // personal opcional: lista limitada
         (d.personal == null || (d.personal is list && d.personal.size() <= 60));
      }

      function validAgenda(d) {
        return isShortString(d.title, 200) &&
               isIsoDate(d.date) &&
               (d.status in ['Programada','En curso','Finalizada','Cancelada']) &&
               (d.documento == null || isShortString(d.documento, 1000)) &&
               isShortString(d.description, 2000);
      }

      function validSustituciones(d) {
  return isShortString(d.sustituto, 200) &&
         isShortString(d.curso, 200) &&
         isShortString(d.asignatura, 200) &&
         // Permite ahora: rango HH:MM-HH:MM (preferido), o única hora HH:MM, o etiqueta corta <=20 (legacy)
         ( (d.hora is string) && ( isHourRange(d.hora) || isHourString(d.hora) || isShortString(d.hora, 20) ) ) &&
         (d.instrucciones == null || isShortString(d.instrucciones, 4000));
      }

      function validNotificacion(d) {
        return (d.tipo in ['anuncio','agenda','tarea_compartida','actividad','sustitucion','update_agenda','update_actividad','update_sustitucion']) &&
               isShortString(d.titulo, 300) &&
               (d.cuerpo == null || isShortString(d.cuerpo, 1000));
      }

  // (Encuestas se validan en su propio match específico)
    }

    // Subcolección de votos de encuestas: un documento por usuario
    match /artifacts/{appId}/public/data/encuestas/{encuestaId}/votos/{voteId} {
      // Permitir obtener sólo el propio voto (no listar)
      allow get: if isAllowedUser() && voteId == request.auth.uid;
      allow create: if isAllowedUser() && voteId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid && request.resource.data.ts is int;
      // Permitir actualizar el propio voto (cambiar índice). Requiere mismos campos base (sólo usuarios permitidos)
      allow update: if isAllowedUser() && voteId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid && request.resource.data.ts is int;
      allow delete: if false;
    }

    // TAREAS PERSONALES: /artifacts/{appId}/users/{userId}/tareas/{taskId}
    match /artifacts/{appId}/users/{userId}/tareas/{taskId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && hasValidBaseFields(request.resource.data) && validTarea(request.resource.data) && request.resource.data.tipo == 'Personal';
      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.timestamp is int &&
        validTarea(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId && resource.data.createdBy == request.auth.uid;
    }

    // ESTADO DE NOTIFICACIONES LEÍDAS POR USUARIO
    // Ruta: /artifacts/{appId}/users/{userId}/notificaciones_leidas/{notifId}
    // Documento mínimo: { read: true, ts: int } (ts=cuando marcó leído)
    match /artifacts/{appId}/users/{userId}/notificaciones_leidas/{notifId} {
      allow read: if request.auth != null && request.auth.uid == userId; // sólo su propio estado
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.read == true && request.resource.data.ts is int;
      allow update: if request.auth != null && request.auth.uid == userId && resource.data.read == true && request.resource.data.read == true && request.resource.data.ts is int;
      allow delete: if false; // no borrar (retención opcional lado servidor)
    }
  }
}